zj-radar peels launcher wrappers (sudo, env, ...) before classifying a pane, but
stops at the first non-option token. For `nono run --profile ... -- <agent>` that
token is `run`, so the pane classifies as a generic command named "run opencode"
instead of the agent. Neither `"nono"` nor `"nono run"` in WRAPPERS fixes this:
the list is matched one argv token at a time via `basename`.

So entries become `(exe, Option<subcommand>)` and a subcommand wrapper consumes
its subcommand plus the flags up to `--`. The `--` skip is scoped to subcommand
entries, leaving the existing ones unchanged.

--- a/crates/core/src/command.rs
+++ b/crates/core/src/command.rs
@@ -232,7 +232,31 @@
 
 /// Launcher exes that prefix the *real* command (`sudo make`, `time cargo
 /// build`, `env FOO=1 pytest`). Classification should see through them.
-const WRAPPERS: &[&str] = &["sudo", "doas", "env", "time", "nice", "command", "exec"];
+///
+/// An entry may name the launcher's own subcommand (`nono run`), which is then
+/// consumed with the wrapper. `None` skips the exe alone.
+const WRAPPERS: &[(&str, Option<&str>)] = &[
+    ("sudo", None),
+    ("doas", None),
+    ("env", None),
+    ("time", None),
+    ("nice", None),
+    ("command", None),
+    ("exec", None),
+    ("nono", Some("run")),
+];
+
+/// Tokens a wrapper at `command[i]` consumes, or `None` if it is not a wrapper.
+/// A subcommand entry matches only on the immediately following token, so
+/// `nono --help` is not peeled as `nono run`.
+fn wrapper_len(command: &[String], i: usize) -> Option<usize> {
+    let exe = basename(command.get(i)?);
+    let (_, sub) = WRAPPERS.iter().find(|(name, _)| *name == exe)?;
+    match sub {
+        None => Some(1),
+        Some(sub) => (command.get(i + 1).map(String::as_str) == Some(*sub)).then_some(2),
+    }
+}
 

# Persistent herdr agent workspace server + collie PWA bridge for this
# machine (imported only by hosts where the herd should always run). The
# `herdr` and `collie` packages themselves are installed for users via
# home/ai.nix.
#
# collie's `collie start` is broken in the current llm-agents pin (upstream
# needs a compiled CLI the package doesn't ship; fixed by
# https://github.com/numtide/llm-agents.nix/pull/11161) — the bridge itself
# runs fine through the bun wrapper, so the service below is defined
# declaratively instead of being generated by `collie start`. Lifecycle verbs
# like `collie update/restart` may still misbehave until that PR merges; use
# `systemctl --user {restart,status} collie` instead.
{
  inputs,
  pkgs,
  ...
}:

let
  system = pkgs.stdenv.hostPlatform.system;
  herdr = inputs.llm-agents.packages.${system}.herdr;
  collie = inputs.llm-agents.packages.${system}.collie;

  # Pinned everywhere (services + interactive shells) so that agents spawned
  # inside herdr panes and collie always reach the same server socket.
  socketPath = "%h/.config/herdr/herdr.sock";
in
{
  home.sessionVariables.HERDR_SOCKET_PATH = "${socketPath}";

  # herdr's agent hooks (session reporting) need python3; without it they
  # exit silently. Must be on the PATH the *agent shells* run with.
  home.packages = [ pkgs.python3 ];

  # Keep user services running after logout / across reboots: the herd stays
  # up when you SSH away and collie can reach it as soon as the machine is on.
  # Home Manager has no linger option here, so the host sets
  # users.users.felschr.linger (see this module's importing host config).

  systemd.user.services.herdr = {
    Unit = {
      Description = "herdr: agent workspace server";
      After = [ "default.target" ];
      # A phone-only operator can't run `systemctl reset-failed`.
      StartLimitIntervalSec = 0;
    };
    Service = {
      Type = "simple";
      # headless server for supervised/service-style setups (herdr docs)
      ExecStart = "${herdr}/bin/herdr server";
      Restart = "on-failure";
      RestartSec = 5;
      Environment = "HERDR_SOCKET_PATH=${socketPath}";
    };
    Install = {
      WantedBy = [ "default.target" ];
    };
  };

  systemd.user.services.collie = {
    Unit = {
      Description = "collie: web PWA bridge for the herdr agent herd";
      After = [
        "default.target"
        "herdr.service"
      ];
      Wants = [ "herdr.service" ];
      # A phone-only operator can't run `systemctl reset-failed`.
      StartLimitIntervalSec = 0;
    };
    Service = {
      Type = "simple";
      WorkingDirectory = "${collie}/lib/collie";
      # `_exec-bridge` (not `collie start`): home-manager owns the unit.
      ExecStart = "${collie}/bin/collie _exec-bridge";
      # the front door `collie start` would configure on a manual install
      ExecStartPost = "${pkgs.tailscale}/bin/tailscale serve --bg 8787";
      Environment = [
        "HERDR_SOCKET_PATH=${socketPath}"
        "COLLIE_PORT=8787"
        "COLLIE_MUX=herdr"
        "COLLIE_TRUSTED_USER=me@felschr.com"
        "COLLIE_PUBLIC_HOSTS=cmdframe.tail05275.ts.net"
        "HERDR_PLUGIN_CONFIG_DIR=%h/.config/collie"
        "COLLIE_PLUGIN_ROOT=${collie}/lib/collie"
      ];
      # hardening from upstream collie.service (the bridge is remote shell
      # access; ProtectSystem can't be used per upstream — see their comment)
      NoNewPrivileges = true;
      PrivateTmp = true;
      Restart = "on-failure";
      RestartSec = 5;
    };
    Install = {
      WantedBy = [ "default.target" ];
    };
  };
}
